use rrmbasic::compiler::parser::new_parser;
use rrmbasic::compiler::Compiler;
use rrmbasic::scanner::scan;
use rrmbasic::vm::VM;
use rrmbasic::vm::opcode::Value;
use rrmbasic::errors::{ErrorStatus, ErrorType};

#[test]
fn load_program() {
    
    let tests: [(&str, bool, usize, usize, usize); 5] = [
        // source, immediate, program_len, line_number, statement_count
        ("print\n", true, 1, 0, 1), 
        ("print : cls\n", true, 1, 0, 2), 
        ("10 print\n", false, 2, 10, 1), 
        ("10 print : cls\n", false, 2, 10, 2),
        ("20 new : cls : print\n", false, 3, 20, 3),
    ];

    let mut p = new_parser();
    
    for (source, immediate, program_len, line_number, statement_count) in tests {
        let statements = scan(&source);
        let immediate_line = p.load_program_line(statements);
        let prog = p.program.clone();

        assert_eq!(immediate_line, immediate, "Testing immediate mode");
        assert_eq!(prog.keys().len(), program_len, "Testing program length");
        let line_statements = prog.get(&line_number).expect("Line number does not exist in program");
        assert_eq!(line_statements.len(), statement_count, "Testing statement count");
    }
}

#[test]
fn simple_literals() {

    let tests: [(&str, f64); 30] = [
        ("1.0+2\n", 3.0), 
        ("10.0-4\n", 6.0), 
        ("3.0*5\n", 15.0), 
        ("20.0/4\n", 5.0),
        ("2.0^3\n", 8.0),
        ("1.5+2.5\n", 4.0),
        ("5.5-2.2\n", 3.3),
        ("2.5*4.0\n", 10.0),
        ("7.5/2.5\n", 3.0),
        ("1.5^2\n", 2.25),
        ("2.0+3*4\n", 14.0),
        ("10.0-6/2\n", 7.0),
        ("4.0*2^3\n", 32.0),
        ("(2+3)*4\n", 20.0),
        ("10.0/(2.0+3.0)\n", 2.0),
        ("(5.5-1.5)^2\n", 16.0),
        ("2.5*(4+6)/2\n", 12.5),
        ("2.0^3^2\n", 512.0),
        ("3.0+5*2^3-10/2\n", 38.0),
        ("(4.5+1.5)*(2^4-6.0)/3.0\n", 20.0),
        ("12.0 and 5\n", 4.0),
        ("12.0 or 5\n", 13.0),
        ("12.0 xor 5\n", 9.0),
        ("5.0 and -3\n", 5.0),
        ("5.0 or -3\n", -3.0),
        ("10.0 xor -1\n", -11.0),
        ("not 5\n", -6.0),
        ("not -10\n", 9.0),
        ("8.0 and 7\n", 0.0),
        ("-15.0 or 0\n", -15.0),
    ];

    for (source, expected_value) in tests {
        let mut error_status = ErrorStatus{
            error_type: ErrorType::Ok,
            line_number: 0,
            statement_number: 0,
            token_sequence: 0,
        };

        let stmts = scan(&source);
        
        let p = new_parser();
        let mut cursor = 0;
        let expr_ast = p.parse_expression(&stmts[0].tokens, &mut cursor, &mut error_status);

        let mut compiler = Compiler::new();
        compiler.compile_expression(&expr_ast, &mut error_status);
        compiler.finish();

        let mut vm = VM::new(p, compiler.clone());
        let result = vm.interpret(&compiler.chunk, &mut error_status);

        match result {
            Value::Integer(value) => assert_eq!(value, expected_value as i32),
            Value::Float(value) => assert_eq!(value, expected_value),
            _ => panic!("Expected number value for {}", &source),
        }
    }

}


#[test]
fn variable_assignment() {

    let tests: [(&str, &str, &Value); 13] = [
        ("Bobrito% := 67\n", &String::from("Bobrito%"), &Value::Integer(67)),
        ("Bobrito% := 6+7\n", &String::from("Bobrito%"), &Value::Integer(13)),
        ("Bobrito% := 3.14\n", &String::from("Bobrito%"), &Value::Integer(3)),
        ("Bobrito% := 7/2\n", &String::from("Bobrito%"), &Value::Integer(3)),
        ("Bobrito% := 7.0/2.0\n", &String::from("Bobrito%"), &Value::Integer(3)),
        ("Bandito := 3.14\n", &String::from("Bandito"), &Value::Float(3.14)),
        ("Bandito := 7.0/2.0\n", &String::from("Bandito"), &Value::Float(3.5)),
        ("Bandito := 7/2\n", &String::from("Bandito"), &Value::Float(3.0)), 
        ("Bandito := 7/2.0\n", &String::from("Bandito"), &Value::Float(3.5)),
        ("Bobrito$ := \"Bandito\"\n", &String::from("Bobrito$"), &Value::String(String::from("Bandito"))),
        ("Bobrito$ := \"Ban\" + \"dito\"\n", &String::from("Bobrito$"), &Value::String(String::from("Bandito"))),
        ("Bobrito$ := \"Bandito \" + 67\n", &String::from("Bobrito$"), &Value::String(String::from("Bandito 67"))),
        ("Bobrito$ := 67 +\" Brainrot\"\n", &String::from("Bobrito$"), &Value::String(String::from("67 Brainrot"))),
    ];

    let mut error_status = ErrorStatus{
        error_type: ErrorType::Ok,
        line_number: 0,
        statement_number: 0,
        token_sequence: 0,
    };

    for (source, expected_var, expected_value) in tests {
        let stmts = scan(&source);
        
        let p = new_parser();
        let mut cursor = 0;
        let ast = p.parse_statement(&stmts[0].tokens, &mut cursor, &mut error_status);

        let mut compiler = Compiler::new();
        compiler.compile_statement(&ast, &mut error_status);
        compiler.finish();

        let mut vm = VM::new(p, compiler.clone());
        vm.interpret(&compiler.chunk, &mut error_status);

        let result = vm.globals.get(expected_var).expect("Expected variable not found");

        match result {
            Value::Integer(v) => {
                match expected_value {
                    Value::Integer(ve) => assert_eq!(v, ve, "Wrong value stored"),
                    _ => panic!("Value stored does not match variable type"),
                }
            }
            Value::Float(v) =>  {
                match expected_value {
                    Value::Float(ve) => assert_eq!(v, ve, "Wrong value stored"),
                    _ => panic!("Value stored does not match variable type"),
                }
            }
            Value::String(v) => {
                match expected_value {
                    Value::String(ve) => assert_eq!(v, ve, "Wrong value stored"),
                    _ => panic!("Value stored does not match variable type"),
                }
            }
            Value::Null => panic!("Variable value was not set")
        }
    }

}